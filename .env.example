# Copy to .env.local for local development with `vercel dev`.
# .env and .env.local are gitignored — never commit real values.
#
# In production these are set in Vercel:
#   Project → Settings → Environment Variables
# Setting them there (not here) is the point: this repository is public.

# Required. The admin sign-in password for /admin.
# Use your real password in Vercel, not this placeholder.
ADMIN_PASSWORD=change-me-locally

# Added automatically by the Vercel Postgres/Neon integration in production.
# For local development, paste your Neon connection string here.
DATABASE_URL=

# Optional. 32+ random characters. Signs admin sessions with a key separate
# from the password, so rotating the password does not sign everyone out.
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Optional. Timezone for the timestamps written into the spreadsheet.
EVENT_TIMEZONE=Asia/Kolkata
